# Added by the reviewer: files kept on disk but not needed for the demo, the README commands or results/summary.md.
# Byte-identical copies of checkpoints/policy.npz, and an intermediate checkpoint
checkpoints/main_latest.npz
checkpoints/main_run1_end.npz
checkpoints/main_it800.npz
# smoke-test outputs (regenerated by ./smoke.sh)
checkpoints/smoke_*
logs/smoke_*
logs/smoke_media/
# per-config tuning logs (the chosen parameters are in checkpoints/*_params.json)
checkpoints/*_params_log.json
!checkpoints/review_*_log.json
# per-episode evaluation dumps (~20 MB; summaries are in results/*.json without _episodes)
results/*_episodes.json
# process ids and caches
logs/*.pid
.pytest_cache/
__pycache__/
MUJOCO_LOG.TXT
