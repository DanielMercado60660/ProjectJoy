# Optimizer/RNG resume state written by ppo.train (Adam moments, RNG, history). Not needed by the
# demo, the evals or report.py (they read the .npz weights); kept on disk, excluded from git (~58 MB).
checkpoints/**/*_state.pkl
checkpoints/**/*_state.pkl.tmp
.pytest_cache/
MUJOCO_LOG.TXT

# Round 5: matplotlib cache
results/r5/*/.mplconfig/

# Round 6 WSP: PPO resume state of the matched-budget arms (weights are in wsp/baselines/*.npz)
wsp/baselines/ckpt/*_state.pkl

# Round 6 WSP: weight files stay local (not published)
wsp/**/*.npz
